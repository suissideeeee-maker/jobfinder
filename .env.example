# Data provider: "yfinance" (default, no key needed) or "alphavantage"
# DATA_PROVIDER=yfinance

# Only needed if DATA_PROVIDER=alphavantage (free tier: https://www.alphavantage.co/support/#api-key)
# Note: Alpha Vantage's free tier caps out around 25 requests/day, which a
# 5-min polling loop exhausts in under two hours. Prefer yfinance unless you
# have a paid Alpha Vantage plan.
# ALPHAVANTAGE_API_KEY=your_key_here

# Optional overrides of bot/config.py defaults
# LOG_LEVEL=INFO
